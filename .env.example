# Browser: ONLY these two values are public. Set in apps/web/.env.local or hosting UI.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Server/worker ONLY; never prefix these with VITE_. Keep in secret store.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Dedicated manager_worker DB login recommended; see deployment-worker.md.
DATABASE_URL=postgresql://manager_worker:CHANGE_IN_SECRET_STORE@127.0.0.1:54322/postgres
# AES-256-GCM key: base64 of exactly 32 random bytes; set same key in Edge & worker.
TOKEN_KEY_BASE64=
TOKEN_KEY_ID=key-1
WORKER_ID=worker-1
RENDER_TIMEOUT_MS=120000
MAX_DOWNLOAD_BYTES=52428800
MAX_RENDER_SECONDS=120
# Optional, no AI operation is available until configured. Trusted operator endpoints only.
TEXT_PROVIDER=openai
TEXT_ENDPOINT=
TEXT_MODEL=
TEXT_API_KEY=
TEXT_TIMEOUT_MS=30000
TEXT_TOKEN_BUDGET=2048
# Mastodon >=4.3, fixed administrator-selected HTTPS origin. No arbitrary browser endpoints.
MASTODON_ORIGIN=
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://PROJECT.supabase.co/functions/v1/social-oauth/callback
APP_ORIGIN=http://localhost:5173
# Public-site build: dedicated deployable output dir; no private media copied.
PUBLIC_SITE_ORIGIN=https://news.example.org
SITE_OUTPUT_DIR=site-output
# Optional backend-only deploy hook after debounced rebuild; static hosting deploy required.
SITE_BUILD_HOOK=
# Optional GPU services are NOT provisioned by core deployment.
OLLAMA_MODEL=
LOG_LEVEL=info
