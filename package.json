{
  "name": "manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite apps/web --host 0.0.0.0",
    "build": "vite build apps/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker": "tsx apps/worker/src/main.ts",
    "site:build": "node scripts/site-preview-guard.mjs && tsx apps/public-site/src/build.ts",
    "doctor": "tsx scripts/doctor.ts",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "package": "python3 scripts/package.py"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
